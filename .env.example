# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ADDRESS=http://localhost

# Docker database credentials. Generate unique values before deployment.
POSTGRES_USER=roastin
POSTGRES_PASSWORD=
POSTGRES_DB=roastin

# Optional during local development. Without it, a deterministic demo report is generated.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Durable report generation. Generate the payload key with: openssl rand -base64 32
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=report-generation
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=4
TEMPORAL_PAYLOAD_DIR=.data/temporal-payloads
TEMPORAL_PAYLOAD_MASTER_KEY=
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=
TEMPORAL_POSTGRES_DB=temporal

# Application database and Stripe Checkout.
DATABASE_URL=postgresql://roastin:roastin@localhost:5432/roastin
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_CLASSIC_USD=
STRIPE_PRICE_CLASSIC_EUR=
STRIPE_PRICE_CLASSIC_BRL=
STRIPE_PRICE_QUIZ_USD=
STRIPE_PRICE_QUIZ_EUR=
STRIPE_PRICE_QUIZ_BRL=

# Local-only fallback. Keep false outside local development.
ALLOW_DEMO_PAYMENTS=false
DEPLOYMENT_ENV=local

# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
PHONE_HASH_SECRET=
AUTH_SECRET=

# Local OTP fallback. Never enable outside local development.
ALLOW_DEV_OTP=false

# Official WhatsApp Business Platform Cloud API
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_AUTH_TEMPLATE_NAME=roastin_login_code
WHATSAPP_AUTH_TEMPLATE_LANGUAGE=en_US
WHATSAPP_REPORT_TEMPLATE_NAME=roastin_report_ready
# Leave empty to use the report locale; set en_US while only the English template is approved.
WHATSAPP_REPORT_TEMPLATE_LANGUAGE=
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=
