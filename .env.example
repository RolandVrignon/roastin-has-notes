# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional during local development. Without it, a deterministic demo report is generated.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna

# PostgreSQL and Stripe are wired in the next implementation phase.
DATABASE_URL=postgresql://roastin:roastin@localhost:5432/roastin
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_CLASSIC_USD=

# Local-only fallback. Keep false outside local development.
ALLOW_DEMO_PAYMENTS=false
DEPLOYMENT_ENV=local

# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
PHONE_HASH_SECRET=
AUTH_SECRET=

# Email OTP delivery
RESEND_API_KEY=
EMAIL_FROM=Roastin <hello@example.com>
ALLOW_DEV_OTP=false

# Official WhatsApp Business Platform Cloud API
WHATSAPP_GRAPH_VERSION=v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=roastin_report_ready
