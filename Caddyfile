{
	admin localhost:2019
}

{$APP_ADDRESS:http://localhost} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	reverse_proxy web:3000 {
		health_uri /
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format console
	}
}
